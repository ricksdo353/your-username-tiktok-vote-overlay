# Copy these into your host's "Environment" settings (Render, PythonAnywhere, …).
# NEVER commit real values to GitHub.

# ---- Required ----
ADMIN_PASSWORD=choose-a-long-password-here      # at least 12 characters
SECRET_KEY=paste-64-random-characters-here      # at least 32 characters

# ---- Twilio (leave empty to run in safe dry-run mode) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567                 # your Twilio number, +E.164 format
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx       # optional, use instead of FROM_NUMBER

# Your app's public address, no trailing slash. Needed for delivery-status webhooks.
PUBLIC_BASE_URL=https://your-app.onrender.com

# ---- Optional ----
# SMS_MODE=live                    # live | dry_run (default: live when Twilio is configured)
# APP_NAME=SMS Tester
# APP_TIMEZONE=America/New_York    # "daily" limits reset at midnight in this zone
# DATABASE_PATH=/var/data/sms_tester.db
# DEFAULT_COUNTRY_CODE=1           # lets you type local numbers without +1
# COOKIE_SECURE=true               # set false ONLY for local http:// testing

# ---- Safety limits (defaults shown) ----
# GLOBAL_DAILY_LIMIT=50
# GLOBAL_PER_MINUTE_LIMIT=5
# RECIPIENT_DAILY_LIMIT=5
# RECIPIENT_MIN_INTERVAL_SECONDS=60
# DUPLICATE_WINDOW_MINUTES=10
# MAX_BODY_CHARS=480
# OPTIN_COOLDOWN_HOURS=24
# OPTIN_MAX_REQUESTS=2
# APPEND_OPT_OUT_FOOTER=true
